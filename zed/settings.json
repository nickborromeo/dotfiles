// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "cli_default_open_behavior": "new_window",
  "icon_theme": "Monospace Icon Theme - Dark",
  "cursor_shape": "bar",
  "search_wrap": true,
  "tabs": {
    "git_status": false,
  },
  "title_bar": {
    "show_user_picture": false,
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_project_items": true,
  },
  "show_wrap_guides": false,
  "rounded_selection": true,
  "selection_highlight": true,
  "current_line_highlight": "line",
  "text_rendering_mode": "platform_default",
  "buffer_line_height": "standard",
  "buffer_font_weight": 400.0,
  "diff_view_style": "split",
  "project_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "theme": "Github Light",
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_size": 15.0,
  "buffer_font_family": "Iosevka",
  "cursor_blink": false,
  "scrollbar": {
    "cursors": true,
    "show": "never",
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
  },
  "preferred_line_length": 120,
  "soft_wrap": "editor_width",
  "wrap_guides": [120],
  "show_whitespaces": "none",
  "terminal": {
    "copy_on_select": true,
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "outline_panel": {
    "dock": "left",
    "button": false,
  },
  "ssh_connections": [
    {
      "host": "localhost",
      "username": "vscode",
      "port": 2222,
      "args": ["-o", "NoHostAuthenticationForLocalhost=yes", "-o", "PasswordAuthentication=no"],
      "projects": [
        {
          "paths": ["/workspaces/github"],
        },
      ],
      "nickname": "dotcom",
    },
  ],
  "format_on_save": "on",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "lsp": {
    "ruby-lsp": {
      "binary": {
        "path": "/Users/nickborromeo/.rbenv/versions/4.0.6/bin/ruby-lsp",
        "env": {
          "BUNDLE_GEMFILE": "/Users/nickborromeo/.config/zed/ruby-lsp/Gemfile",
        },
      },
      "settings": {
        "use_bundler": false,
      },
    },
    "sorbet": {
      "binary": {
        "path": "/Users/nickborromeo/.rbenv/versions/4.0.6/lib/ruby/gems/4.0.0/gems/sorbet-static-0.6.13108-universal-darwin/libexec/sorbet",
        "arguments": ["@sorbet/config"],
      },
      "settings": {
        "use_bundler": false,
      },
    },
  },
  "languages": {
    "Ruby": {
      "language_servers": ["ruby-lsp", "!rubocop", "sorbet", "!solargraph"],
    },
  },
  "experimental.theme_overrides": {
    "editor.document_highlight.read_background": "#00000000",
    "editor.document_highlight.write_background": "#00000000",
  },
}
